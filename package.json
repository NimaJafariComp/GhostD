{
  "name": "ghostd",
  "version": "0.1.3",
  "description": "Local-first, revision-pinned context for developer agents.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/NimaJafariComp/GhostD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NimaJafariComp/GhostD.git"
  },
  "bugs": {
    "url": "https://github.com/NimaJafariComp/GhostD/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "codex",
    "claude",
    "gemini",
    "developer-tools",
    "context"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "extensions/vscode"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ghost": "./dist/cli/main.js",
    "ghostd": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "integrations",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build --workspace ghostd-vscode",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace ghostd-vscode",
    "test": "vitest run",
    "verify:package": "node scripts/verify-package.mjs",
    "release:verify": "npm run typecheck && npm run build && npm test && npm run verify:package",
    "release:artifact": "node scripts/create-release-artifact.mjs",
    "release:vsix": "node scripts/create-vsix-artifact.mjs",
    "release:install-test": "node scripts/test-release-install.mjs",
    "release:formula": "node scripts/render-homebrew-formula.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vscode/vsce": "^3.9.2",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
