{
  "name": "ghostd-vscode",
  "displayName": "GhostD",
  "description": "Inspect and select captured GhostD sessions from VS Code.",
  "version": "0.1.6",
  "private": true,
  "publisher": "ghostd",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NimaJafariComp/GhostD"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/ghostd-icon.png",
  "files": [
    "dist",
    "resources",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:ghostd.connect",
    "onCommand:ghostd.configureCodex",
    "onCommand:ghostd.configureClaude",
    "onCommand:ghostd.configureGemini",
    "onCommand:ghostd.selectSession",
    "onCommand:ghostd.showContext",
    "onCommand:ghostd.copyHandoff",
    "onCommand:ghostd.showDetectedHosts",
    "onCommand:ghostd.openDashboard",
    "onCommand:ghostd.refresh"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ghostd.connect",
        "title": "GhostD: Connect this workspace"
      },
      {
        "command": "ghostd.configureCodex",
        "title": "GhostD: Configure Codex capture"
      },
      {
        "command": "ghostd.configureClaude",
        "title": "GhostD: Configure Claude Code capture"
      },
      {
        "command": "ghostd.configureGemini",
        "title": "GhostD: Configure Gemini CLI capture"
      },
      {
        "command": "ghostd.selectSession",
        "title": "GhostD: Select captured session"
      },
      {
        "command": "ghostd.showContext",
        "title": "GhostD: Show current context"
      },
      {
        "command": "ghostd.copyHandoff",
        "title": "GhostD: Copy branch handoff"
      },
      {
        "command": "ghostd.showDetectedHosts",
        "title": "GhostD: Show detected IDE agent hosts"
      },
      {
        "command": "ghostd.openDashboard",
        "title": "GhostD: Open dashboard",
        "icon": "$(hubot)"
      },
      {
        "command": "ghostd.disconnect",
        "title": "GhostD: Disconnect this workspace"
      },
      {
        "command": "ghostd.refresh",
        "title": "GhostD: Refresh sessions"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ghostd.sessions",
          "name": "GhostD Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ghostd.sessions",
        "contents": "GhostD keeps captured agent context portable and revision-pinned.\n[Open GhostD dashboard](command:ghostd.openDashboard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ghostd.openDashboard",
          "when": "view == ghostd.sessions",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "GhostD",
      "properties": {
        "ghostd.cliPath": {
          "type": "string",
          "default": "ghost",
          "description": "Path or command name for the GhostD CLI used by this workspace extension host."
        },
        "ghostd.codexCliPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the Codex CLI. Use this only when the VS Code extension host cannot find Codex on PATH; GhostD uses its directory while configuring Codex capture."
        },
        "ghostd.claudeCliPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the Claude Code CLI. Use this only when the VS Code extension host cannot find Claude on PATH; GhostD uses its directory while configuring Claude Code capture."
        },
        "ghostd.geminiCliPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the Gemini CLI. Use this only when the VS Code extension host cannot find Gemini on PATH; GhostD uses its directory while configuring Gemini CLI capture."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:extension-host": "node ./test/run-extension.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.8.0"
  }
}
